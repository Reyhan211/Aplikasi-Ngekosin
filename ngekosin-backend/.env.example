# Salin file ini menjadi ".env" lalu sesuaikan jika perlu.
# Nilai default di bawah sudah cocok dengan Laragon (root, tanpa password).

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ngekosin

# Ganti dengan teks acak yang panjang (wajib jika dipakai di server sungguhan)
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
JWT_EXPIRES=30d

# Batas percobaan login/daftar per IP dalam 15 menit
AUTH_RATE_LIMIT=60
